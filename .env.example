# Runtime mode used by application-specific schemas.
NODE_ENV=development

# API listener port. Task 0.4 will consume this value.
API_PORT=3001

# Exact browser origin allowed to call the API. Wildcards are not accepted.
API_CORS_ORIGIN=http://localhost:3000

# Browser-safe API origin. Do not place secrets in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Direct PostgreSQL connection used by Prisma CLI and server-side runtime code.
DATABASE_URL=postgres://postgres:postgres@localhost:51214/template1?sslmode=disable
